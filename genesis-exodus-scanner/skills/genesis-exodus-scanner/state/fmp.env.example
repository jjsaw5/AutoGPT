# Copy this file to fmp.env (same directory) and fill in your key.
# fmp.env is .gitignore'd — never commit your real key.
#
# Alternatively, set FMP_API_KEY as an environment variable in whatever
# shell/session runs the skill; fmp.py checks the environment first and
# only falls back to this file.
FMP_API_KEY=<YOUR_FMP_API_KEY>
