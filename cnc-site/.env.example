# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API in your Supabase dashboard)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Contact form email delivery  (https://resend.com)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
# Where contact-form messages are delivered (the shop owner's inbox)
CONTACT_EMAIL_TO=owner@example.com
# Verified sender address on your Resend account/domain.
# During testing you can use: onboarding@resend.dev
CONTACT_EMAIL_FROM=Website <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Public site info (shown in the footer / contact page)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SHOP_NAME=Ironline Machine Works
NEXT_PUBLIC_SHOP_PHONE=(555) 012-3456
NEXT_PUBLIC_SHOP_EMAIL=owner@example.com
NEXT_PUBLIC_SHOP_LOCATION=Cleveland, OH
