# Options Opportunity Scanner — secrets template.
# Copy to `.env` (which is gitignored) and fill in. NEVER commit real keys.

# Financial Modeling Prep (data backbone)
FMP_API_KEY=your_fmp_key_here

# Unusual Whales (options flow / vol / GEX edge layer)
UW_API_KEY=your_unusual_whales_key_here

# Robinhood live quotes / greeks / buying power / execution is accessed via the
# Robinhood MCP server (human-gated), not an API key here.

# Turso (durable run-history DB — libSQL/SQLite over HTTPS). Optional: without
# these, history still persists to committed JSONL + local SQLite; with them,
# each scan also writes through to the hosted DB. Provision with:
#   turso db create apitrading && turso db show apitrading --url
#   turso db tokens create apitrading
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
