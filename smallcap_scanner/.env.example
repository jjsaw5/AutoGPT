# Copy to .env and fill in. The tool auto-loads .env if python-dotenv is installed.

# --- Financial Modeling Prep (market data / screener) ---
# Get a key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# FMP_BASE_URL=https://financialmodelingprep.com/stable
# FMP_ENRICH_LIMIT=300

# --- Reddit (social scan) ---
# Default mode "auto" needs NO credentials below: it uses ApeWisdom (free,
# licensed, no-auth) for wallstreetbets/pennystocks, and scrapes the public
# RSS feeds for the niche subs ApeWisdom doesn't track (TheRaceTo10Million,
# raceto10000, smallstreetbets). Read smallcap_scanner/reddit_rss_client.py
# before relying on the RSS portion — Reddit's robots.txt disallows
# automated access to those feeds, so this is a deliberate, flagged tradeoff,
# not a fully compliant integration.
#
# Set REDDIT_MODE=praw + the credentials below to use official Reddit OAuth
# instead, which IS fully compliant and can reach every subreddit in
# SUBREDDITS (including the niche ones) reliably. Create a "script" app at
# https://www.reddit.com/prefs/apps.
# REDDIT_MODE=auto
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=smallcap-scanner/0.1 (by u/your_username)

# --- Screen thresholds (optional overrides) ---
# PRICE_MIN=0.50
# PRICE_MAX=8.0
# MARKET_CAP_MIN=30000000
# MARKET_CAP_MAX=2000000000
# AVG_VOLUME_MIN=500000
# EXCHANGES=nasdaq,nyse,amex

# --- Social scan tuning ---
# SUBREDDITS=wallstreetbets,TheRaceTo10Million,raceto10000,smallstreetbets,pennystocks   (REDDIT_MODE=praw only)
# APEWISDOM_SUBREDDITS=wallstreetbets,pennystocks
# REDDIT_RSS_SUBREDDITS=TheRaceTo10Million,raceto10000,smallstreetbets
# REDDIT_RSS_DELAY_SECONDS=2.0
# REDDIT_POST_LIMIT=200
# REDDIT_LOOKBACK_HOURS=72

# --- Score weights (need not sum to 1) ---
# WEIGHT_FUNDAMENTAL=0.30
# WEIGHT_MOMENTUM=0.30
# WEIGHT_SOCIAL=0.40
