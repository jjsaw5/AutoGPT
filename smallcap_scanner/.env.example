# Copy to .env and fill in. The tool auto-loads .env if python-dotenv is installed.

# --- Financial Modeling Prep (market data / screener) ---
# Get a key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# FMP_BASE_URL=https://financialmodelingprep.com/stable
# FMP_ENRICH_LIMIT=300

# --- Reddit (social scan) ---
# Default mode "auto" needs NO credentials below: it uses ApeWisdom (free,
# licensed, no-auth, no scraping/ToS conflict) across wallstreetbets,
# pennystocks, Shortsqueeze, SqueezePlays, SPACs and Daytrading.
#
# Set REDDIT_MODE=praw + the credentials below to use official Reddit OAuth
# instead, which can reach the niche subs ApeWisdom doesn't track
# (TheRaceTo10Million, raceto10000, smallstreetbets) — create a "script" app
# at https://www.reddit.com/prefs/apps.
# REDDIT_MODE=auto
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=smallcap-scanner/0.1 (by u/your_username)

# --- Screen thresholds (optional overrides) ---
# PRICE_MIN=0.50
# PRICE_MAX=8.0
# MARKET_CAP_MIN=30000000
# MARKET_CAP_MAX=2000000000
# AVG_VOLUME_MIN=500000
# EXCHANGES=nasdaq,nyse,amex

# --- Social scan tuning ---
# SUBREDDITS=wallstreetbets,pennystocks,Shortsqueeze,SqueezePlays,SPACs,Daytrading,TheRaceTo10Million,raceto10000,smallstreetbets   (REDDIT_MODE=praw only)
# APEWISDOM_SUBREDDITS=wallstreetbets,pennystocks,Shortsqueeze,SqueezePlays,SPACs,Daytrading
# REDDIT_POST_LIMIT=200
# REDDIT_LOOKBACK_HOURS=72
# SOCIAL_FMP_LIMIT=50   (stage 3: how many top social tickers get an FMP lookup)
# FILTER_LARGE_CAPS=true   (skip known large-caps before the FMP lookup; see known_largecaps.py)
# EXTRA_LARGE_CAP_EXCLUSIONS=   (comma list to add more tickers to that blocklist)

# --- Score weights (need not sum to 1) ---
# WEIGHT_FUNDAMENTAL=0.30
# WEIGHT_MOMENTUM=0.30
# WEIGHT_SOCIAL=0.40
